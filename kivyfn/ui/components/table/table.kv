
# =============================== #
#            Table
# =============================== #
<Table>:
    app: app
    orientation: 'vertical'
    column_selection_text_color: app.theme.infoColor
    column_selection_background_color: app.theme.infoBackgroundColor
    
    row_selection_text_color: app.theme.infoColor
    row_selection_background_color: app.theme.infoBackgroundColor

# =============================== #
#         Table Sections
# =============================== #
<TableSectionHeader>:
    scroll_type: ['bars']
    bar_width: 0
    do_scroll: False
    size_hint_y: None
    height: dp(48)

    TableContainer:
        id: container
        orientation: 'horizontal'
        size_hint: None, None
        width: self.minimum_width
        height: root.height
        padding: root.table.section_padding if root.table else 0
        spacing: root.table.section_spacing if root.table else 0


<TableHeader>:
    scroll_type: ['bars']
    bar_width: 0
    do_scroll: False
    size_hint_y: None
    height: dp(48)

    canvas.before:
        Color:
            rgba: app.theme.borderColor
        Line:
            points: [self.x, self.y, self.right, self.y]  
            width: 1

    TableContainer:
        id: container
        orientation: 'horizontal'
        size_hint: None, None
        width: self.minimum_width
        height: root.height
        padding: root.table.section_padding if root.table else 0
        spacing: root.table.section_spacing if root.table else 0



<TableBody>:
    effect_cls: ScrollEffect

    TableContainer:
        id: container
        orientation: 'vertical'
        size_hint: None, None
        size: self.minimum_size


<TableFooter>:
    app: app
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(48)

    padding: dp(12), 0
    spacing: dp(6)

    canvas.before:
        Color:
            rgba: app.theme.borderColor
        Line:
            points: [self.x, self.top, self.right, self.top] 
            width: 1


    Label:
        text: str(root.table.items_page_range[0]) + ' - ' + str(root.table.items_page_range[1]) + ' / ' + str(root.table.items_length)
        size_hint: None, None
        size: self.texture_size
        color: app.theme.onSurfaceColor[:3] + [0.7]
        pos_hint: {'center_y': 0.5}
        font_size: dp(12)

    Widget:

    Label:
        text: app.translate('number_of_items_per_page', app.language)
        text_size: self.size
        halign: 'right'
        valign: 'center'
        shorten: True
        shorten_from: 'right'
        color: app.theme.onSurfaceColor[:3] + [0.7]
        pos_hint: {'center_y': 0.5}
        font_size: dp(12)

    SelectionField:
        text_key: str(root.table.items_per_page) if root.table else '---'
        on_open_menu: root.open_menu(self)
        font_size: dp(12)
        custom_width: dp(75)

    Widget:
        size_hint_x: None
        width: dp(16)

    BoxLayout:
        orientation: "horizontal"
        size_hint_x: None
        width: self.minimum_width
        spacing: dp(32)
        IconButton:
            icon: 'chevron-left'
            color: app.theme.onSurfaceColor
            on_release: root.previous_page()
            pos_hint: {'center_y': 0.5}
            font_size: dp(21)

        IconButton:
            icon: 'chevron-right'
            color: app.theme.onSurfaceColor
            on_release: root.next_page()
            pos_hint: {'center_y': 0.5}
            font_size: dp(21)


# =============================== #
#           Table Rows
# =============================== #
<TableRow>:
    orientation: 'horizontal'
    size_hint: None, None
    width: self.minimum_width
    height: dp(48)
    padding: root.table.section_padding if root.table else 0
    spacing: root.table.section_spacing if root.table else 0

    canvas.before:   
        # Divider line
        Color:
            rgba: app.theme.borderColor
        Line:
            points: [self.x, self.y, self.right, self.y]  
            width: 1  


# =============================== #
#           Table Cell
# =============================== #
<TableCell>:
    size_hint_x: None

<TableSectionHeaderCell>:
    size_hint_x: None
    anchor_x: 'left'
    anchor_y: 'bottom'


# =============================== #
#           Table Labels
# =============================== #
<CoreTableText>:
    # font
    markup: True
    font_name: "arial"

    # size
    size_hint: None, None
    text_size: (None, None) if self.custom_width is None else (self.custom_width, None) 
    height: self.texture_size[1] if self.custom_height is None else self.custom_height
    width: self.texture_size[0] if self.custom_width is None else self.custom_width

    # padding
    padding: dp(6)

    # alignment
    halign: 'left'
    valign: 'center'

    # position
    pos_hint: {'center_y': 0.5}

    # color
    color: self.text_color
    disabled_color: self.disabled_color
    
    canvas.before:
        # background color
        Color:
            rgba: self.background_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: self.radius


<TableText>:
    text_color: app.theme.onSurfaceColor
    text:
        app.translate(self.leading_text, app.language) + \
        (self.leading_delimiter if self.leading_text else '') + \
        app.translate(self.text_key, app.language) + \
        (self.trailing_delimiter if self.trailing_text else '') + \
        app.translate(self.trailing_text, app.language) + \
        (self.icon_delimiter if self.icon_markup else '') + \
        self.icon_markup

<TableLiveText>:
    text_color: app.theme.onSurfaceColor
    text:
        app.translate(self.leading_text, app.language) + \
        (self.leading_delimiter if self.leading_text else '') + \
        app.translate(self.value, app.language) + \
        (self.trailing_delimiter if self.trailing_text else '') + \
        app.translate(self.trailing_text, app.language) + \
        (self.icon_delimiter if self.icon_markup else '') + \
        self.icon_markup
    
<TableHeaderText>:
    text_color: app.theme.hintColor
    text:
        '[ref=sort]' + \
        app.translate(self.leading_text, app.language) + \
        (self.leading_delimiter if self.leading_text else '') + \
        app.translate(self.text_key, app.language) + \
        (self.trailing_delimiter if self.trailing_text else '') + \
        app.translate(self.trailing_text, app.language) + \
        (self.icon_delimiter if self.icon_markup else '') + \
        self.icon_markup \
        + '[/ref]'

<TableSectionHeaderText>:
    size_hint: None, None
    size: self.texture_size
    font_size: dp(16)
    padding: dp(6), dp(6), dp(12), dp(6)
    color: app.theme.infoColor
    bold: True
    text:
        app.translate(self.text_key, app.language) + \
        (self.trailing_delimiter if self.trailing_text else '') + \
        app.translate(self.trailing_text, app.language)

    canvas.before:
        Color:
            rgba: app.theme.infoBackgroundColor 
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(6), dp(6), dp(0), dp(0)]



# ================================ #
#           Table Buttons
# ================================ #  
<TableButton>:
    # Size
    padding: dp(6), 0
    custom_width: self.texture_size[0] + dp(12)
    custom_height: dp(20)
    font_size: dp(12)
