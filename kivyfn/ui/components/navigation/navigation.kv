
<KcNavigation>:
    screen_manager: screen_manager
    splash_screen: splash_screen

    canvas.before:
        Color:
            rgba: root.bg_color
        Rectangle:
            pos: self.pos
            size: self.size

    KcView:
        orientation: 'vertical'

        ScreenManager:
            id: screen_manager
            transition: SlideTransition()

            KcSplashScreen:
                id: splash_screen
                image: root.splash_image
                progress_bar_color: root.progress_bar_color
                progress_bar_bg_color: root.progress_bar_bg_color
                progress_bar_limit: root.progress_bar_limit
