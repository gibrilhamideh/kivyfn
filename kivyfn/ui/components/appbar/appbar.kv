

<KcAppBar>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(40)

    canvas.before:
        Color:
            rgba: app.theme.primaryColor
        Rectangle:
            pos: self.pos
            size: self.size

    KcAppBarLeftContent:
        orientation: 'horizontal'
        size_hint_x: None
        width: self.minimum_width


    KcAppBarDivider:


    KcAppBarRightContent:
        orientation: 'horizontal'
        size_hint_x: None
        width: self.minimum_width