<KcSplashScreen>:
    name: 'splash_screen'
    progress_bar: progress_bar

    canvas.before:
        Color:
            rgba: root.bg_color
        Rectangle:
            pos: self.pos
            size: self.size

    Image:
        source: root.image
        pos_hint: {'center_x': 0.5, 'center_y': 0.6}

    KcProgressBar:
        id: progress_bar
        color: root.progress_bar_color
        bg_color: root.progress_bar_bg_color
        limit: root.progress_bar_limit
        size_hint_x: 0.5
        pos_hint: {'center_x': 0.5, 'center_y': 0.2}