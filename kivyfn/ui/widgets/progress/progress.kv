<KcProgressBar>:
    height: dp(5)
    size_hint_y: None
    
    canvas.before:
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: root.radius

    canvas:
        Color:
            rgba: self.color
        RoundedRectangle:
            size: self._width, self.height
            pos: self.pos
            radius: root.radius if root.limit == root.value else [root.radius[0], 0, 0, root.radius[3]]
