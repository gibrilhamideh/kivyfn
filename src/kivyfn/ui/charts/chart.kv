<FnChart>:
    background_color: app.theme.color.surfaceContainerLow
    plot_background_color: app.theme.color.surface
    grid_color: app.theme.color.outlineVariant
    axis_color: app.theme.color.outline
    text_color: app.theme.color.onSurface
    crosshair_color: app.theme.color.alpha("onSurface", 0.65)
    selection_color: app.theme.color.onSurface
