<FnElevationBehavior>
    canvas.before:

        Color:
            rgba: root.shadow_color

        BoxShadow:
            pos: root.pos if not isinstance(root, RelativeLayout) else (0, 0)
            size: root.size
            offset: dp(root.shadow_offset[0]), dp(root.shadow_offset[1])
            spread_radius: -(dp(root.shadow_softness[0])), -(dp(root.shadow_softness[1]))
            blur_radius: root.elevation_levels[root.elevation]
            border_radius: root.radius
