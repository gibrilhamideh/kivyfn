# <FnClipBehavior>
#     canvas.before:
#         StencilPush
#
#         RoundedRectangle:
#             pos: (0, 0) if isinstance(root, RelativeLayout) else root.pos
#             size: root.size
#             radius: root.radius
#
#         StencilUse
#
#     canvas.after:
#         StencilUnUse
#         StencilPop


<FnClipBehavior>:
    canvas.before:
        StencilPush
        
        RoundedRectangle:
            pos: self.pos if not isinstance(self, RelativeLayout) else (0, 0)
            size: self.size
            radius: self.radius
        StencilUse


    canvas.after:
        StencilUnUse
        RoundedRectangle:
            pos: self.pos if not isinstance(self, RelativeLayout) else (0, 0)
            size: self.size
            radius: self.radius
        StencilPop
